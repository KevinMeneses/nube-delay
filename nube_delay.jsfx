// ---- medidores
pk_in = max(m_in, pk_in * 0.999); pk_out = max(m_out, pk_out * 0.999); pk_wet = max(m_wet, pk_wet * 0.999);
_mi = m_in; _mo = m_out; _mw = m_wet; m_in *= 0.82; m_out *= 0.82; m_wet *= 0.82;
_mt = dy + 18 * SC; _mh = dh - 36 * SC; _bw = 18 * SC;
_k = 0;
loop(3,
  _xx = mx0 + 8 * SC + _k * 28 * SC;
  gfx_set(0.13, 0.14, 0.18, 1); gfx_rect(_xx, _mt, _bw, _mh, 1);
  _v = _k == 0 ? _mi : _k == 1 ? _mw : _mo;
