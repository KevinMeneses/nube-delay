desc:Nube Delay - delay (5 estilos, a tempo, ping-pong, filtros, saturacion, modulacion, ducking, freeze)
//tags: delay echo tape analog bbd ping-pong tempo ducking freeze lofi
//author: Kev Meneses + Claude (Claude Code)
//license: GPL-3.0-or-later
//version: 1.1.0

slider1:375<1,2000,0.1:log=300>-Tiempo (ms)
slider2:9<0,14,1{Apagado,1/32,1/16T,1/16,1/8T,1/16.,1/8,1/4T,1/8.,1/4,1/2T,1/4.,1/2,1/2.,1/1}>-A tempo
slider3:0<-50,50,0.1>-Desfase R (%)
slider4:35<0,100,0.1>-Feedback (%)
slider5:25<0,100,0.1>-Mezcla (%)
slider6:0<0,2,1{Estereo,Ping-pong,Mono}>-Ruteo
slider7:0<0,4,1{Digital,Cinta,Analogico,Lo-fi,Difuso}>-Estilo
slider8:120<20,2000,1:log=200>-Corte grave (Hz; 20 = apagado)
slider9:8000<1000,20000,10:log=5000>-Corte agudo (Hz; 20000 = apagado)
slider10:0<0,100,0.1>-Saturacion (%)
slider11:0<0,100,0.1>-Modulacion (%)
slider12:0.6<0.05,5,0.01:log=0.6>-Mod velocidad (Hz)
slider13:0<0,100,0.1>-Difusion (%)
slider14:100<0,200,0.1>-Ancho (%)
slider15:0<0,24,0.1>-Ducking (dB)
slider16:-30<-60,0,0.1>-Ducking umbral (dB)
slider17:250<50,2000,1:log=300>-Ducking recuperacion (ms)
slider18:0<0,1,1{Apagado,Encendido}>-Freeze
slider19:0<0,1,1{Inserto,Envio (100% humedo)}>-Uso
slider20:0<-24,12,0.1>-Salida (dB)
slider21:0<0,23,1{-,Voz - negra con ducking (cinta),Voz rap - 1/8 con puntillo ping-pong,Voz - retorno negra (envio),Slapback (rap 90s),Dub / dancehall (feedback alto),Cinta vieja,Analogico oscuro (BBD),Lo-fi / telefono,Ambient difuso (pads),Doble ancho (Haas),Voz trap - 1/4 ping-pong con ducking,Voz drill - 1/8 tresillo,Eco de final de frase (1/2 envio),Throw de voz lejano (1/4. envio),Doblador corto (chorus de voz),Guitarra / pluck - 1/8. ancho,Rhodes / keys - cinta suave,Snare - eco 1/16 (trap),Hi-hat - 1/32 brillo,Pad - nube difusa (envio),Textura casi infinita (envio),Radio en la pared (lo-fi 1/4),Por defecto}>-Cargar preset

in_pin:Entrada L
in_pin:Entrada R
out_pin:Salida L
out_pin:Salida R

options:gfx_hz=60 no_meter maxmem=4194304

@init
ext_noinit = 1;
gfx_ext_retina = 1;

BUFN = ceil(4.3 * srate) + 8;           // 4 s + modulacion
bufL = 0; bufR = BUFN;
B0 = 2 * BUFN + 64;                     // el resto de la memoria va despues de los buffers
cHP = B0; cLP = B0 + 8; cX1 = B0 + 16; cX2 = B0 + 24;   // coeficientes SVF [g, k, a1, a2, a3]
sL = B0 + 40; sR = B0 + 80;                             // estados del lazo por canal (40)
APN = 4096; apL = B0 + 200; apR = apL + 4 * APN;        // 4 pasa-todo de difusion por canal
NH = 600; histIn = apR + 4 * APN + 16; histWet = histIn + NH;
hitmem = histWet + NH + 16;

// ---------------------------------------------------------------- utilidades
function clamp(x, a, b) ( x < a ? a : x > b ? b : x );
function db2a(x) ( 10 ^ (x / 20) );
function nlog(v, a, b) ( log(v / a) / log(b / a) );
function dlog(n, a, b) ( a * (b / a) ^ n );
function nlin(v, a, b) ( (v - a) / (b - a) );
function dlin(n, a, b) ( a + (b - a) * n );

function sset(i, v)
(
  i == 1 ? ( slider1 = v; slider_automate(slider1); ) : i == 2 ? ( slider2 = v; slider_automate(slider2); ) :
  i == 3 ? ( slider3 = v; slider_automate(slider3); ) : i == 4 ? ( slider4 = v; slider_automate(slider4); ) :
  i == 5 ? ( slider5 = v; slider_automate(slider5); ) : i == 6 ? ( slider6 = v; slider_automate(slider6); ) :
  i == 7 ? ( slider7 = v; slider_automate(slider7); ) : i == 8 ? ( slider8 = v; slider_automate(slider8); ) :
  i == 9 ? ( slider9 = v; slider_automate(slider9); ) : i == 10 ? ( slider10 = v; slider_automate(slider10); ) :
  i == 11 ? ( slider11 = v; slider_automate(slider11); ) : i == 12 ? ( slider12 = v; slider_automate(slider12); ) :
  i == 13 ? ( slider13 = v; slider_automate(slider13); ) : i == 14 ? ( slider14 = v; slider_automate(slider14); ) :
  i == 15 ? ( slider15 = v; slider_automate(slider15); ) : i == 16 ? ( slider16 = v; slider_automate(slider16); ) :
  i == 17 ? ( slider17 = v; slider_automate(slider17); ) : i == 18 ? ( slider18 = v; slider_automate(slider18); ) :
  i == 19 ? ( slider19 = v; slider_automate(slider19); ) : i == 20 ? ( slider20 = v; slider_automate(slider20); ) :
  i == 21 ? ( slider21 = v; slider_automate(slider21); );
);

// figuras: duracion en negras
function note_beats(n) (
  n == 1 ? 0.125 : n == 2 ? 0.166667 : n == 3 ? 0.25 : n == 4 ? 0.333333 : n == 5 ? 0.375 : n == 6 ? 0.5 :
  n == 7 ? 0.666667 : n == 8 ? 0.75 : n == 9 ? 1 : n == 10 ? 1.333333 : n == 11 ? 1.5 : n == 12 ? 2 : n == 13 ? 3 : 4;
);
function note_name(n) (
  n == 1 ? "1/32" : n == 2 ? "1/16 T" : n == 3 ? "1/16" : n == 4 ? "1/8 T" : n == 5 ? "1/16 ." : n == 6 ? "1/8" :
  n == 7 ? "1/4 T" : n == 8 ? "1/8 ." : n == 9 ? "1/4" : n == 10 ? "1/2 T" : n == 11 ? "1/4 ." : n == 12 ? "1/2" : n == 13 ? "1/2 ." : "1/1";
);

// ---------------------------------------------------------------- filtros (SVF trapezoidal, Simper)
function setc(c, f, k) local(g)
( g = tan($pi * min(f, srate * 0.45) / srate); c[0] = g; c[1] = k; c[2] = 1 / (1 + g * (g + k)); c[3] = g * c[2]; c[4] = g * c[3]; );
function svf(x, c, s) local(v1, v2, v3)
(
  v3 = x - s[1];
  v1 = c[2] * s[0] + c[3] * v3;
  v2 = s[1] + c[3] * s[0] + c[4] * v3;
  s[0] = 2 * v1 - s[0]; s[1] = 2 * v2 - s[1];
  f_lp = v2; f_bp = v1; f_hp = x - c[1] * v1 - v2;
);
// saturacion suave (aprox. de tanh, lineal para senales chicas)
function sat(x) local(y)
( x = clamp(x, -3, 3); x * (27 + x * x) / (27 + 9 * x * x); );

// pasa-todo de difusion: b = [indice, largo, linea...]
function apf(x, b, len, g) local(i, d, y)
(
  i = b[0]; d = b[2 + i];
  y = d - g * x; b[2 + i] = x + g * y;
  (i += 1) >= len ? i = 0; b[0] = i;
  y;
);

// lectura con interpolacion de Hermite (4 puntos); d en muestras (>= 3)
function rd(buf, w, d) local(r, i, f, i0, i2, i3, x0, x1, x2, x3, c1, c2, c3)
(
  r = w - d; r < 0 ? r += BUFN;
  i = floor(r); f = r - i;
  i0 = i - 1; i0 < 0 ? i0 += BUFN;
  i2 = i + 1; i2 >= BUFN ? i2 -= BUFN;
  i3 = i2 + 1; i3 >= BUFN ? i3 -= BUFN;
  x0 = buf[i0]; x1 = buf[i]; x2 = buf[i2]; x3 = buf[i3];
  c1 = 0.5 * (x2 - x0); c2 = x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3; c3 = 0.5 * (x3 - x0) + 1.5 * (x1 - x2);
  ((c3 * f + c2) * f + c1) * f + x1;
);

// estilos: modulacion propia, saturacion propia, difusion propia, filtro extra
function st_mod(s) ( s == 1 ? 0.18 : s == 2 ? 0.12 : 0 );
function st_sat(s) ( s == 1 ? 0.25 : s == 2 ? 0.2 : s == 3 ? 0.15 : 0 );
function st_dif(s) ( s == 4 ? 0.65 : 0 );
function st_glide(s) ( s == 1 || s == 2 ? 0.25 : 0.06 );

function update_params() local(dms, dr, e)
(
  sync = slider2;
  dms = sync ? note_beats(sync) * 60000 / max(tempo, 20) : slider1;
  dms = clamp(dms, 1, 4000);
  del_ms = dms;
  dr = clamp(dms * (1 + slider3 / 100), 1, 4000);
  delR_ms = dr;
  dLt = max(dms * 0.001 * srate, 3); dRt = max(dr * 0.001 * srate, 3);
  fb = slider4 / 100;
  mixv = slider5 / 100;
  routing = slider6; style = slider7;
  hp_on = slider8 > 20.5; hp_on ? setc(cHP, slider8, 1.41421356);
  lp_on = slider9 < 19990; lp_on ? setc(cLP, slider9, 1.41421356);
  // filtros propios del estilo (cinta: 7 kHz suave; analogico: 3.5 kHz; lo-fi: banda de telefono)
  style == 1 ? setc(cX1, 7000, 1.6) : style == 2 ? setc(cX1, 3500, 1.3) : style == 3 ? ( setc(cX1, 3200, 1.2); setc(cX2, 380, 1.2); );
  drive = 1 + 4 * (slider10 / 100 + st_sat(style));
  sat_on = drive > 1.001;
  modamt = clamp(slider11 / 100 + st_mod(style), 0, 1.2);
  mod_samp = modamt * (1.2 + 0.004 * dms) * 0.001 * srate;     // profundidad en muestras
  lfo_inc = slider12 / srate;
  flut_inc = 6.3 / srate;
  difg = clamp(slider13 / 100 + st_dif(style), 0, 1) * 0.7;
  dif_on = difg > 0.001;
  e = 1 + (dms > 120 ? 1 : dms / 120);          // largo de la difusion segun el tiempo
  apn1 = min(floor(0.0031 * e * srate), APN - 4); apn2 = min(floor(0.0047 * e * srate), APN - 4);
  apn3 = min(floor(0.0071 * e * srate), APN - 4); apn4 = min(floor(0.0109 * e * srate), APN - 4);
  width = slider14 / 100;
  duck_on = slider15 >= 0.05; dkdepth = slider15; dkthr = slider16;
  dkatk = exp(-1 / (0.005 * srate)); dkrel = exp(-1 / (slider17 * 0.001 * srate));
  pkr = exp(-1 / (0.03 * srate));
  frz = slider18;
  sendmode = slider19;
  dg_t = sendmode ? 0 : cos(mixv * $pi * 0.5);
  wg_t = sendmode ? 1 : sin(mixv * $pi * 0.5);
  og_t = db2a(slider20);
  glide = 1 - exp(-1 / (st_glide(style) * srate));
  sm = 1 - exp(-1 / (0.02 * srate));
  dck = 1 - exp(-2 * $pi * 10 / srate);
  crush_q = 256; hold_n = 3;
  hslot = floor(0.01 * srate);
  last_tempo = tempo;
);

// lazo de un canal: filtros, estilo, saturacion y difusion. s = estados, ab = pasa-todos
function loop_proc(v, s, ab) local(x)
(
  x = v;
  hp_on ? ( svf(x, cHP, s); x = f_hp; );
  lp_on ? ( svf(x, cLP, s + 2); x = f_lp; );
  style == 1 || style == 2 ? ( svf(x, cX1, s + 4); x = f_lp; ) :
  style == 3 ? (
    svf(x, cX1, s + 4); x = f_lp; svf(x, cX2, s + 6); x = f_hp;
    // menos bits y menos frecuencia de muestreo
    (s[10] -= 1) <= 0 ? ( s[10] = hold_n; s[11] = floor(x * crush_q + 0.5) / crush_q; );
    x = s[11];
  );
  sat_on ? x = sat(x * drive) / drive * (1 + 0.15 * (drive - 1));
  // DC fuera (la saturacion no deja que se acumule)
  s[12] += (x - s[12]) * dck; x -= s[12];
  dif_on ? (
    x = apf(x, ab, apn1, difg); x = apf(x, ab + APN, apn2, difg);
    x = apf(x, ab + 2 * APN, apn3, difg); x = apf(x, ab + 3 * APN, apn4, difg);
  );
  clamp(x, -4, 4);
);

wpos = 0; upd = 0;
memset(0, 0, 2 * BUFN);
_i = 0; loop(NH, histIn[_i] = histWet[_i] = -200; _i += 1; );
update_params();
dL = dLt; dR = dRt; a_dg = dg_t; a_wg = wg_t; a_og = og_t; a_fz = 1;
mph = 0; fph = 0;

// ---------------------------------------------------------------- presets
NPRESETS = 23;
function preset_name(n)
(
  n == 1 ? "Voz - negra con ducking (cinta)" :
  n == 2 ? "Voz rap - 1/8 con puntillo ping-pong" :
  n == 3 ? "Voz - retorno negra (envio)" :
  n == 4 ? "Slapback (rap 90s)" :
  n == 5 ? "Dub / dancehall (feedback alto)" :
  n == 6 ? "Cinta vieja" :
  n == 7 ? "Analogico oscuro (BBD)" :
  n == 8 ? "Lo-fi / telefono" :
  n == 9 ? "Ambient difuso (pads)" :
  n == 10 ? "Doble ancho (Haas)" :
  n == 11 ? "Voz trap - 1/4 ping-pong con ducking" :
  n == 12 ? "Voz drill - 1/8 tresillo" :
  n == 13 ? "Eco de final de frase (1/2 envio)" :
  n == 14 ? "Throw de voz lejano (1/4. envio)" :
  n == 15 ? "Doblador corto (chorus de voz)" :
  n == 16 ? "Guitarra / pluck - 1/8. ancho" :
  n == 17 ? "Rhodes / keys - cinta suave" :
  n == 18 ? "Snare - eco 1/16 (trap)" :
  n == 19 ? "Hi-hat - 1/32 brillo" :
  n == 20 ? "Pad - nube difusa (envio)" :
  n == 21 ? "Textura casi infinita (envio)" :
  n == 22 ? "Radio en la pared (lo-fi 1/4)" :
  n == 23 ? "Por defecto" : "";
);
// pr(estilo, ruteo, tempo (0 = ms), ms, feedback, mezcla, corte grave, corte agudo)
function pr(st, ru, nt, ms, f, mx, lo, hi)
( sset(7, st); sset(6, ru); sset(2, nt); sset(1, ms); sset(4, f); sset(5, mx); sset(8, lo); sset(9, hi); );
function load_preset(n)
(
  pr(0, 0, 9, 375, 35, 25, 120, 8000);
  sset(3, 0); sset(10, 0); sset(11, 0); sset(12, 0.6); sset(13, 0); sset(14, 100);
  sset(15, 0); sset(16, -30); sset(17, 250); sset(18, 0); sset(19, 0); sset(20, 0);
  n == 1 ? ( pr(1, 0, 9, 375, 25, 18, 250, 6000); sset(15, 8); ) :
  n == 2 ? ( pr(0, 1, 8, 375, 30, 16, 300, 5000); sset(15, 10); ) :
  n == 3 ? ( pr(1, 0, 9, 375, 30, 100, 300, 5000); sset(19, 1); sset(15, 6); ) :
  n == 4 ? ( pr(1, 2, 0, 110, 0, 22, 150, 5000); ) :
  n == 5 ? ( pr(1, 1, 8, 375, 70, 30, 300, 2500); sset(10, 40); sset(11, 20); ) :
  n == 6 ? ( pr(1, 0, 6, 375, 45, 25, 120, 4500); sset(10, 30); sset(11, 50); sset(12, 0.4); ) :
  n == 7 ? ( pr(2, 0, 9, 375, 50, 25, 100, 3000); sset(11, 30); ) :
  n == 8 ? ( pr(3, 0, 6, 375, 35, 25, 20, 20000); ) :
  n == 9 ? ( pr(4, 0, 11, 375, 65, 35, 150, 6000); sset(11, 30); sset(14, 150); ) :
  n == 10 ? ( pr(0, 0, 0, 12, 0, 30, 20, 20000); sset(3, 50); sset(14, 200); );
  n == 11 ? ( pr(0, 1, 9, 375, 35, 20, 250, 6000); sset(15, 10); );
  n == 12 ? ( pr(0, 1, 4, 375, 30, 15, 300, 5000); sset(15, 8); );
  n == 13 ? ( pr(1, 0, 12, 375, 45, 100, 300, 4500); sset(19, 1); sset(15, 12); );
  n == 14 ? ( pr(2, 1, 11, 375, 55, 100, 400, 3500); sset(19, 1); sset(10, 20); );
  n == 15 ? ( pr(2, 0, 0, 25, 0, 25, 150, 8000); sset(3, 30); sset(11, 40); sset(12, 0.8); );
  n == 16 ? ( pr(0, 1, 8, 375, 40, 25, 200, 7000); sset(14, 150); );
  n == 17 ? ( pr(1, 0, 9, 375, 30, 18, 150, 5000); sset(10, 15); sset(11, 25); sset(12, 0.5); );
  n == 18 ? ( pr(0, 0, 3, 375, 20, 15, 400, 8000); );
  n == 19 ? ( pr(0, 1, 1, 375, 40, 12, 1000, 12000); );
  n == 20 ? ( pr(4, 0, 11, 375, 75, 100, 200, 5000); sset(19, 1); sset(13, 80); sset(11, 30); sset(14, 180); );
  n == 21 ? ( pr(4, 0, 9, 375, 90, 100, 150, 5000); sset(19, 1); sset(13, 60); sset(11, 20); sset(20, -4); );
  n == 22 ? ( pr(3, 0, 9, 375, 40, 30, 500, 3000); sset(10, 40); );
  upd = 1;
);

@slider
slider21 > 0 ? ( _pn = floor(slider21 + 0.5); slider21 = 0; slider_automate(slider21); load_preset(_pn); );
update_params();

@block
(upd || (sync && tempo != last_tempo)) ? ( upd = 0; update_params(); );
// detenido (o al empezar a sonar) el tiempo y las ganancias saltan directo; sonando se deslizan (como una cinta)
_ps = play_state & 5; (!_ps || !last_ps) ? ( dL = dLt; dR = dRt; a_dg = dg_t; a_wg = wg_t; a_og = og_t; a_fz = frz ? 0 : 1; ); last_ps = _ps;

@sample
a_inL = spl0; a_inR = spl1;
a_dg += (dg_t - a_dg) * sm; a_wg += (wg_t - a_wg) * sm; a_og += (og_t - a_og) * sm;
a_fz += ((frz ? 0 : 1) - a_fz) * sm;
dL += (dLt - dL) * glide; dR += (dRt - dR) * glide;

// modulacion: wow (velocidad del usuario) + flutter suave en cinta
mph += lfo_inc; mph >= 1 ? mph -= 1;
fph += flut_inc; fph >= 1 ? fph -= 1;
a_mL = mod_samp * (0.5 + 0.5 * sin(2 * $pi * mph));
a_mR = mod_samp * (0.5 + 0.5 * sin(2 * $pi * (mph + 0.25)));
style == 1 ? ( a_fl = mod_samp * 0.08 * sin(2 * $pi * fph); a_mL += a_fl; a_mR -= a_fl; );

a_oL = rd(bufL, wpos, dL + a_mL);
a_oR = rd(bufR, wpos, dR + a_mR);

// entrada al lazo segun el ruteo
a_xm = (a_inL + a_inR) * 0.5;
frz ? (
  routing == 1 ? ( a_vL = a_oR; a_vR = a_oL; ) : ( a_vL = a_oL; a_vR = a_oR; );
) : (
  routing == 0 ? ( a_vL = a_inL * a_fz + fb * a_oL; a_vR = a_inR * a_fz + fb * a_oR; ) :
  routing == 1 ? ( a_vL = a_xm * a_fz + fb * a_oR; a_vR = fb * a_oL; ) :
                 ( a_vL = a_xm * a_fz + fb * a_oL; a_vR = a_xm * a_fz + fb * a_oR; );
  a_vL = loop_proc(a_vL, sL, apL); a_vR = loop_proc(a_vR, sR, apR);
);
bufL[wpos] = a_vL; bufR[wpos] = a_vR;
(wpos += 1) >= BUFN ? wpos = 0;

// ducking: el eco baja mientras suena la entrada
a_x = max(abs(a_inL), abs(a_inR));
a_env = a_x > a_env ? a_x : a_env * pkr;
duck_on ? (
  a_t = clamp(20 * log10(a_env + 0.0000000001) - dkthr, 0, dkdepth);
  a_dk = a_t > a_dk ? a_t + (a_dk - a_t) * dkatk : a_t + (a_dk - a_t) * dkrel;
  a_dkg = exp(-0.1151292546 * a_dk);
) : ( a_dk = 0; a_dkg = 1; );

// ancho (M/S del eco)
a_m = (a_oL + a_oR) * 0.5; a_s = (a_oL - a_oR) * 0.5 * width;
a_wL = (a_m + a_s) * a_dkg; a_wR = (a_m - a_s) * a_dkg;

spl0 = (a_inL * a_dg + a_wL * a_wg) * a_og;
spl1 = (a_inR * a_dg + a_wR * a_wg) * a_og;

// medidores e historial
a_x > m_in ? m_in = a_x; a_x > h_in ? h_in = a_x;
a_y = max(abs(a_wL), abs(a_wR)) * a_wg; a_y > m_wet ? m_wet = a_y; a_y > h_wet ? h_wet = a_y;
a_y = max(abs(spl0), abs(spl1)); a_y > m_out ? m_out = a_y;
dk_now = a_dk;
(a_hc -= 1) <= 0 ? (
  a_hc = hslot;
  histIn[hw] = 20 * log10(h_in + 0.0000001); histWet[hw] = 20 * log10(h_wet + 0.0000001);
  (hw += 1) >= NH ? hw = 0;
  h_in = h_wet = 0;
);

@gfx 1000 640
// ======================================================================= interfaz
SC = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
WW = gfx_w; WH = gfx_h;

function fnt(i) (
  i == 1 ? gfx_setfont(1, "Helvetica Neue", 13 * SC) :
  i == 2 ? gfx_setfont(2, "Helvetica Neue", 11 * SC) :
  i == 3 ? gfx_setfont(3, "Helvetica Neue", 17 * SC, 'b') :
  i == 4 ? gfx_setfont(4, "Helvetica Neue", 10 * SC, 'b') :
  i == 6 ? gfx_setfont(6, "Helvetica Neue", 15 * SC, 'b') :
           gfx_setfont(5, "Helvetica Neue", 12 * SC, 'b');
);
function style_rgb(st, a)
(
  st == 0 ? gfx_set(0.42, 0.78, 1.00, a) :
  st == 1 ? gfx_set(1.00, 0.70, 0.36, a) :
  st == 2 ? gfx_set(0.95, 0.48, 0.42, a) :
  st == 3 ? gfx_set(0.72, 0.86, 0.45, a) :
            gfx_set(0.78, 0.60, 1.00, a);
);
function acc(a) ( style_rgb(slider7, a); );
function style_name(st) ( st == 0 ? "Digital" : st == 1 ? "Cinta" : st == 2 ? "Analogico" : st == 3 ? "Lo-fi" : "Difuso"; );
function rout_name(r) ( r == 0 ? "Estereo" : r == 1 ? "Ping-pong" : "Mono"; );

function hit_add(x, y, w, h, id) local(p)
( hit_n < 200 ? ( p = hitmem + hit_n * 5; p[0] = x; p[1] = y; p[2] = w; p[3] = h; p[4] = id; hit_n += 1; ); );
function hit_find(mx, my) local(i, p, r)
(
  r = 0; i = hit_n - 1;
  while (i >= 0 && r == 0) (
    p = hitmem + i * 5;
    (mx >= p[0] && mx < p[0] + p[2] && my >= p[1] && my < p[1] + p[3]) ? r = p[4];
    i -= 1;
  );
  r;
);
function frect(x, y, w, h, r) (
  r = min(r, min(w, h) * 0.5);
  gfx_rect(x + r, y, w - 2 * r, h, 1);
  gfx_rect(x, y + r, r, h - 2 * r, 1);
  gfx_rect(x + w - r, y + r, r, h - 2 * r, 1);
  gfx_circle(x + r, y + r, r, 1, 1); gfx_circle(x + w - r - 1, y + r, r, 1, 1);
  gfx_circle(x + r, y + h - r - 1, r, 1, 1); gfx_circle(x + w - r - 1, y + h - r - 1, r, 1, 1);
);
function text_c(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 1 | 4, x + w, y + h); );
function text_l(str, x, y, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 4, x + 2000, y + h); );
function text_r(str, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(str, 2 | 4, x + w, y + h); );
function fmt_f(d, f) ( f < 1000 ? sprintf(d, "%d Hz", floor(f + 0.5)) : sprintf(d, f < 10000 ? "%.2f kHz" : "%.1f kHz", f / 1000); );
function fmt_ms(d, t) ( t < 10 ? sprintf(d, "%.1f ms", t) : t < 1000 ? sprintf(d, "%d ms", floor(t + 0.5)) : sprintf(d, "%.2f s", t / 1000); );

function button(id, x, y, w, h, str, on)
(
  hov = hover_id == id;
  on ? acc(1) : gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  on ? gfx_set(0.07, 0.08, 0.10, 1) : gfx_set(0.86, 0.88, 0.92, 1);
  fnt(1); text_c(str, x, y, w, h);
  hit_add(x, y, w, h, id);
);
function dropdown(id, x, y, w, h, label, str)
(
  hov = hover_id == id;
  gfx_set(hov ? 0.24 : 0.17, hov ? 0.26 : 0.19, hov ? 0.31 : 0.24, 1);
  frect(x, y, w, h, 5 * SC);
  fnt(2); gfx_set(0.55, 0.58, 0.65, 1);
  text_l(label, x + 8 * SC, y, h);
  strlen(label) ? gfx_measurestr(label, _tw, _th) : _tw = -4 * SC;
  fnt(1); gfx_set(0.90, 0.92, 0.96, 1);
  text_l(str, x + 12 * SC + _tw, y, h);
  gfx_set(0.55, 0.58, 0.65, 1);
  _cx = x + w - 12 * SC; _cy = y + h * 0.5;
  gfx_triangle(_cx - 4 * SC, _cy - 2 * SC, _cx + 4 * SC, _cy - 2 * SC, _cx, _cy + 3 * SC);
  hit_add(x, y, w, h, id);
);
function knob(id, cx, cy, r, label, str, n, bip, enabled) local(a0, a1, av, i, rr)
(
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; av = a0 + (a1 - a0) * clamp(n, 0, 1);
  fnt(2); gfx_set(0.62, 0.65, 0.72, enabled ? 1 : 0.4);
  text_c(label, cx - 50 * SC, cy - r - 18 * SC, 100 * SC, 14 * SC);
  gfx_set(0.13, 0.14, 0.18, 1); gfx_circle(cx, cy, r, 1, 1);
  gfx_set(0.26, 0.28, 0.34, 1);
  i = 0; loop(3 * SC, gfx_arc(cx, cy, r - 2 * SC - i, a0, a1, 1); i += 1; );
  acc(enabled ? 1 : 0.35);
  i = 0; loop(3 * SC, rr = r - 2 * SC - i;
    bip ? ( av < 0 ? gfx_arc(cx, cy, rr, av, 0, 1) : gfx_arc(cx, cy, rr, 0, av, 1); )
        : gfx_arc(cx, cy, rr, a0, av, 1);
    i += 1; );
  gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.4);
  gfx_line(cx + sin(av) * r * 0.25, cy - cos(av) * r * 0.25, cx + sin(av) * (r - 6 * SC), cy - cos(av) * (r - 6 * SC), 1);
  hover_id == id ? ( gfx_set(1, 1, 1, 0.12); gfx_circle(cx, cy, r + 2 * SC, 0, 1); );
  fnt(1); gfx_set(0.92, 0.93, 0.96, enabled ? 1 : 0.45);
  text_c(str, cx - 50 * SC, cy + r + 3 * SC, 100 * SC, 16 * SC);
  hit_add(cx - r - 8 * SC, cy - r - 4 * SC, 2 * r + 16 * SC, 2 * r + 24 * SC, id);
);

// ---------------------------------------------------------- controles: id -> slider, minimo, maximo, log, defecto, paso
// id 1 (Tiempo) es especial: en ms o, a tempo, recorre las figuras
function ctl_info(id)
(
  id == 1 ? ( ci_s = 1; ci_a = 1; ci_b = 2000; ci_l = 1; ci_d = 375; ci_p = 0.1; ) :
  id == 2 ? ( ci_s = 3; ci_a = -50; ci_b = 50; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 3 ? ( ci_s = 4; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 35; ci_p = 0.1; ) :
  id == 4 ? ( ci_s = 5; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 25; ci_p = 0.1; ) :
  id == 5 ? ( ci_s = 8; ci_a = 20; ci_b = 2000; ci_l = 1; ci_d = 120; ci_p = 1; ) :
  id == 6 ? ( ci_s = 9; ci_a = 1000; ci_b = 20000; ci_l = 1; ci_d = 8000; ci_p = 10; ) :
  id == 7 ? ( ci_s = 20; ci_a = -24; ci_b = 12; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 8 ? ( ci_s = 10; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 9 ? ( ci_s = 11; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 10 ? ( ci_s = 12; ci_a = 0.05; ci_b = 5; ci_l = 1; ci_d = 0.6; ci_p = 0.01; ) :
  id == 11 ? ( ci_s = 13; ci_a = 0; ci_b = 100; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 12 ? ( ci_s = 14; ci_a = 0; ci_b = 200; ci_l = 0; ci_d = 100; ci_p = 0.1; ) :
  id == 13 ? ( ci_s = 15; ci_a = 0; ci_b = 24; ci_l = 0; ci_d = 0; ci_p = 0.1; ) :
  id == 14 ? ( ci_s = 16; ci_a = -60; ci_b = 0; ci_l = 0; ci_d = -30; ci_p = 0.1; ) :
  id == 15 ? ( ci_s = 17; ci_a = 50; ci_b = 2000; ci_l = 1; ci_d = 250; ci_p = 1; ) :
  ci_s = 0;
);
function ctl_get(id) local(v)
(
  id == 1 && slider2 ? (slider2 - 1) / 13 : (
    ctl_info(id); v = slider(ci_s); ci_l ? nlog(v, ci_a, ci_b) : nlin(v, ci_a, ci_b);
  );
);
function ctl_setv(id, v)
(
  ctl_info(id);
  v = clamp(floor(v / ci_p + 0.5) * ci_p, ci_a, ci_b);
  sset(ci_s, v); upd = 1;
);
function ctl_set(id, n)
(
  n = clamp(n, 0, 1);
  id == 1 && slider2 ? ( sset(2, 1 + floor(n * 13 + 0.5)); upd = 1; ) : (
    ctl_info(id); ctl_setv(id, ci_l ? dlog(n, ci_a, ci_b) : dlin(n, ci_a, ci_b));
  );
);
function ctl_default(id) ( id == 1 && slider2 ? ( sset(2, 9); upd = 1; ) : ( ctl_info(id); ctl_setv(id, ci_d); ); );

// ---------------------------------------------------------- ayudas
function style_desc(st, line)
(
  st == 0 ? ( line == 0 ? "Limpio y exacto: cada eco igual al original" : "(solo con los filtros que elijas). Moderno." ) :
  st == 1 ? ( line == 0 ? "Eco de cinta: cada repeticion mas oscura y tibia," : "con wow y flutter. Clasico en voz, dub y reggae." ) :
  st == 2 ? ( line == 0 ? "Delay analogico (BBD): oscuro, suave y con" : "algo de chorus. Se queda atras, no molesta." ) :
  st == 3 ? ( line == 0 ? "Lo-fi: banda de telefono, menos bits y menos" : "muestreo. Para efectos y transiciones." ) :
            ( line == 0 ? "Difuso: los ecos se desenfocan y se vuelven casi" : "reverb. Pads, guitarras y voces ambient." );
);
function hint_for(id)
(
  id == 1 ? strcpy(#hint, slider2 ? "Tiempo a tempo: gira para elegir la figura (1/8, 1/4, con puntillo o tresillo). Sigue el BPM del proyecto." : "Tiempo en ms: distancia entre ecos. Tambien: arrastra izquierda/derecha en la grafica, o usa Tap.") :
  id == 2 ? strcpy(#hint, "Desfase R: el lado derecho repite un poco antes o despues que el izquierdo. Abre la imagen (y +50% = doble ancho).") :
  id == 3 ? strcpy(#hint, "Feedback: cuantas repeticiones. 0 = un solo eco, 30-50% = varios, 70%+ = dub. Tambien: arrastra arriba/abajo en la grafica.") :
  id == 4 ? strcpy(#hint, "Mezcla: cuanto eco se escucha. En voz 10-25%. Con Uso = Envio queda 100% eco (para una pista de retorno).") :
  id == 5 ? strcpy(#hint, "Corte grave: quita graves de los ecos (no embarran la mezcla). 200-400 Hz en voz. Arrastra el punto en la curva.") :
  id == 6 ? strcpy(#hint, "Corte agudo: oscurece los ecos para que queden atras de la voz. 3-6 kHz es lo usual. Cada repeticion se oscurece mas.") :
  id == 7 ? strcpy(#hint, "Salida: volumen final.") :
  id == 8 ? strcpy(#hint, "Saturacion: calienta y redondea cada repeticion (cinta / consola). Con feedback alto se va 'comiendo' sola.") :
  id == 9 ? strcpy(#hint, "Modulacion: el tiempo oscila un poco (wow). Da vida y ancho; mucho = efecto de cinta vieja.") :
  id == 10 ? strcpy(#hint, "Velocidad de la modulacion. Lenta (0.2-1 Hz) = cinta; rapida = chorus.") :
  id == 11 ? strcpy(#hint, "Difusion: desenfoca cada eco (como una pequena reverb dentro del delay).") :
  id == 12 ? strcpy(#hint, "Ancho: 0% = ecos al centro, 100% = normal, 200% = mas abiertos.") :
  id == 13 ? strcpy(#hint, "Ducking: el eco baja mientras cantas y sube en los silencios. La voz queda clara y los ecos llenan los huecos.") :
  id == 14 ? strcpy(#hint, "Umbral del ducking: sobre este nivel de entrada el eco empieza a bajar.") :
  id == 15 ? strcpy(#hint, "Recuperacion del ducking: cuanto tarda el eco en volver cuando paras de cantar.") :
  id == 20 ? strcpy(#hint, "A tempo: el tiempo sigue el BPM del proyecto (1/8, 1/4, puntillos, tresillos). Apagado = en ms.") :
  id == 21 ? strcpy(#hint, "Tap: haz clic al ritmo (3-4 veces) y el delay toma ese tiempo.") :
  id == 22 ? strcpy(#hint, "Freeze: congela lo que esta sonando en el delay y lo repite para siempre. Lo que entra no se graba.") :
  id == 23 ? strcpy(#hint, "Uso: Inserto (seca + eco) o Envio (100% eco, para una pista de retorno con envios).") :
  id == 30 ? strcpy(#hint, "Presets: puntos de partida para voz, slapback, dub/dancehall, cinta, lo-fi y ambient. Para guardar los tuyos usa el + de REAPER.") :
  id == 31 ? strcpy(#hint, "Ruteo: Estereo (cada lado su eco), Ping-pong (los ecos saltan izquierda-derecha), Mono (al centro).") :
  (id >= 40 && id <= 44) ? (
    strcpy(#hint, style_name(id - 40)); strcat(#hint, ": "); strcat(#hint, style_desc(id - 40, 0)); strcat(#hint, " "); strcat(#hint, style_desc(id - 40, 1));
  ) :
  id == 100 ? strcpy(#hint, "Ecos: cada barra es una repeticion (arriba L, abajo R). Arrastra izq/der = tiempo, arriba/abajo = feedback | clic der. = presets") :
  id == 101 ? strcpy(#hint, "Tono de los ecos: la linea es el primer eco, la sombra el tercero. Arrastra los puntos = cortes grave y agudo.") :
  id == 102 ? strcpy(#hint, "Medidores: entrada, eco y salida, con el maximo arriba. Clic = reiniciar maximos.") :
  strcpy(#hint, "Nube Delay: elige un preset, ajusta Tiempo, Feedback y Mezcla. Pasa el mouse sobre cualquier cosa para ver que hace.");
);
function menu_presets() local(r, i)
(
  #m = "#PRESETS DE NUBE DELAY";
  i = 1; loop(NPRESETS, strcat(#m, "|"); strcat(#m, preset_name(i)); i += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r >= 2 ? load_preset(r - 1);
);
function menu_rout() local(r)
(
  #m = ""; strcat(#m, slider6 == 0 ? "!Estereo" : "Estereo"); strcat(#m, slider6 == 1 ? "|!Ping-pong" : "|Ping-pong"); strcat(#m, slider6 == 2 ? "|!Mono" : "|Mono");
  gfx_x = mouse_x; gfx_y = mouse_y;
  r = gfx_showmenu(#m);
  r > 0 ? ( sset(6, r - 1); upd = 1; );
);

// ---------------------------------------------------------- respuesta del lazo (para dibujar), con la deformacion bilineal
function lp2(f, fc) local(w) ( w = tan($pi * min(f, srate * 0.49) / srate) / tan($pi * min(fc, srate * 0.45) / srate); 1 / sqrt(1 + w * w * w * w); );
function hp2(f, fc) local(w) ( w = tan($pi * min(fc, srate * 0.45) / srate) / tan($pi * min(f, srate * 0.49) / srate); 1 / sqrt(1 + w * w * w * w); );
function loop_mag(f) local(m)
(
  m = 1;
  slider8 > 20.5 ? m *= hp2(f, slider8);
  slider9 < 19990 ? m *= lp2(f, slider9);
  slider7 == 1 ? m *= lp2(f, 9000) : slider7 == 2 ? m *= lp2(f, 4200) : slider7 == 3 ? m *= lp2(f, 3600) * hp2(f, 340);
  m;
);

// ======================================================================= layout
TOPH = 44 * SC; PANH = 228 * SC; FOOTH = 26 * SC;
dy = TOPH + 10 * SC;
dh = WH - TOPH - PANH - FOOTH - 20 * SC; dh < 140 * SC ? dh = 140 * SC;
MW = 96 * SC; mx0 = WW - 14 * SC - MW;
fw = min(dh * 1.25, (WW - MW - 90 * SC) * 0.40);
fx0 = mx0 - 16 * SC - fw;
hx = 14 * SC; hgw = fx0 - 16 * SC - hx; hy = dy; hh = dh;
py = dy + dh + 10 * SC;
FLO = 20; FHI = 20000;
function f2x(f) ( fx0 + fw * clamp(log(f / FLO) / log(FHI / FLO), 0, 1) );
function x2f(x) ( FLO * (FHI / FLO) ^ clamp((x - fx0) / fw, 0, 1) );
function fdb2y(d) ( dy + 22 * SC + (dh - 40 * SC) * clamp(-d / 36, 0, 1) );

// ======================================================================= mouse
mx = mouse_x; my = mouse_y;
lb = mouse_cap & 1; rb = mouse_cap & 2; shift = mouse_cap & 8;
hover_id = drag ? drag_id : hit_find(mx, my);

lb && !last_lb ? (
  _now = time_precise();
  dbl = _now - last_t < 0.35 && abs(mx - last_x) < 6 * SC && abs(my - last_y) < 6 * SC;
  last_t = dbl ? 0 : _now; last_x = mx; last_y = my;
  (hover_id >= 1 && hover_id <= 15) ? (
    dbl ? ctl_default(hover_id) : ( drag = 1; drag_id = hover_id; drag_my = my; drag_n = ctl_get(hover_id); );
  ) : hover_id == 100 ? (
    drag = 1; drag_id = 100; drag_mx = mx; drag_my = my; drag_n = ctl_get(1); drag_v = slider4;
  ) : hover_id == 110 ? ( dbl ? ctl_default(5) : ( drag = 1; drag_id = 110; ); )
    : hover_id == 111 ? ( dbl ? ctl_default(6) : ( drag = 1; drag_id = 111; ); )
    : hover_id == 102 ? ( m_in = m_out = m_wet = 0; pk_in = pk_out = pk_wet = 0; )
    : hover_id == 20 ? ( sset(2, slider2 ? 0 : (last_note ? last_note : 9)); upd = 1; )
    : hover_id == 21 ? (
      // tap: promedio de los ultimos intervalos (se reinicia si pasan mas de 2 s)
      _now - tap_t > 2 ? tap_n = 0 : ( tap_n < 4 ? tap_n += 1; tap_iv = tap_n == 1 ? _now - tap_t : tap_iv + ((_now - tap_t) - tap_iv) / tap_n;
        sset(2, 0); sset(1, clamp(floor(tap_iv * 10000 + 0.5) / 10, 1, 2000)); upd = 1; );
      tap_t = _now;
    )
    : hover_id == 22 ? ( sset(18, !slider18); upd = 1; )
    : hover_id == 23 ? ( sset(19, !slider19); upd = 1; )
    : hover_id == 30 ? menu_presets()
    : hover_id == 31 ? menu_rout()
    : (hover_id >= 40 && hover_id <= 44) ? ( sset(7, hover_id - 40); upd = 1; );
);
slider2 ? last_note = slider2;
lb && drag ? (
  _k = shift ? 0.1 : 1;
  (drag_id >= 1 && drag_id <= 15) ? ctl_set(drag_id, drag_n + (drag_my - my) / (220 * SC) * _k) :
  drag_id == 100 ? (
    ctl_set(1, drag_n + (mx - drag_mx) / hgw * 0.8 * _k);
    ctl_setv(3, drag_v + (drag_my - my) / hh * 100 * _k);
  ) :
  drag_id == 110 ? ctl_setv(5, x2f(mx)) :
  drag_id == 111 ? ( _f = x2f(mx); ctl_setv(6, _f > 18000 ? 20000 : _f); );
);
!lb ? drag = 0;
rb && !last_rb ? ( (hover_id == 100 || hover_id == 101) ? menu_presets(); );
mouse_wheel != 0 ? (
  _w = mouse_wheel / 120;
  (hover_id == 1 && slider2) ? ( sset(2, clamp(slider2 + sign(_w), 1, 14)); upd = 1; ) :     // a tempo: una figura por paso
  (hover_id >= 1 && hover_id <= 15) ? ctl_set(hover_id, ctl_get(hover_id) + _w * (shift ? 0.002 : 0.012)) :
  hover_id == 100 ? ctl_setv(3, slider4 + _w * (shift ? 0.2 : 1));
  mouse_wheel = 0;
);
last_lb = lb; last_rb = rb;

// ======================================================================= dibujo
hit_n = 0;
gfx_set(0.075, 0.082, 0.105, 1); gfx_rect(0, 0, WW, WH, 1);

// ---- barra superior
gfx_set(0.10, 0.11, 0.14, 1); gfx_rect(0, 0, WW, TOPH, 1);
fnt(3); gfx_set(0.62, 0.80, 1.0, 1); text_l("NUBE", 14 * SC, 0, TOPH);
gfx_measurestr("NUBE ", _tw, _th);
gfx_set(0.93, 0.94, 0.97, 1); text_l("DELAY", 14 * SC + _tw, 0, TOPH);
_x = 130 * SC; _y = 9 * SC; _h = 26 * SC;
dropdown(30, _x, _y, 116 * SC, _h, "", "Presets"); _x += 124 * SC;
dropdown(31, _x, _y, 170 * SC, _h, "Ruteo", rout_name(slider6)); _x += 178 * SC;
button(23, _x, _y, 150 * SC, _h, slider19 ? "Envio (100% eco)" : "Inserto", slider19); _x += 158 * SC;
_x + 200 * SC < WW ? (
  fnt(2); gfx_set(0.55, 0.58, 0.65, 1); text_r(slider2 ? "A TEMPO" : "TIEMPO", WW - 260 * SC, _y, 90 * SC, _h);
  fnt(6); acc(1);
  slider2 ? sprintf(#s, "%s  %d ms", note_name(slider2), floor(del_ms + 0.5)) : fmt_ms(#s, del_ms);
  text_r(#s, WW - 164 * SC, _y, 150 * SC, _h);
);

// ---- patron de ecos
gfx_set(0.095, 0.105, 0.135, 1); gfx_rect(hx, hy, hgw, hh, 1);
_mid = hy + hh * 0.5;
// ventana de tiempo: hasta que el eco baja de -48 dB (entre 4 y 12 repeticiones)
_g1 = loop_mag(1000);
_dm = max(del_ms, delR_ms);
_nrep = 12; slider4 > 0.5 && slider18 == 0 ? ( _nrep = clamp(ceil(-48 / (20 * log10(slider4 / 100 * _g1 + 0.000001))) + 1, 4, 12); ) : slider4 <= 0.5 ? _nrep = 4;
slider6 == 1 ? _tw_ms = (del_ms + delR_ms) * 0.5 * (_nrep + 0.6) : _tw_ms = _dm * (_nrep + 0.6);
function t2x(t) ( hx + 24 * SC + (hgw - 36 * SC) * t / _tw_ms );
function lv2h(d) ( (hh * 0.5 - 22 * SC) * clamp((d + 48) / 48, 0, 1) );
// rejilla de tiempo
fnt(4);
_st = _tw_ms > 6000 ? 1000 : _tw_ms > 2400 ? 500 : _tw_ms > 1000 ? 250 : _tw_ms > 400 ? 100 : 50;
_t = 0; while (_t <= _tw_ms) (
  _xx = t2x(_t); gfx_set(1, 1, 1, 0.045); gfx_line(_xx, hy + 18 * SC, _xx, hy + hh - 16 * SC);
  gfx_set(0.50, 0.53, 0.60, 1); _t >= 1000 ? sprintf(#s, "%.1f s", _t / 1000) : sprintf(#s, "%d", _t);
  text_c(#s, _xx - 24 * SC, hy + hh - 15 * SC, 48 * SC, 14 * SC);
  _t += _st;
);
gfx_set(1, 1, 1, 0.08); gfx_line(hx + 8 * SC, _mid, hx + hgw - 8 * SC, _mid);
fnt(4); gfx_set(0.50, 0.53, 0.60, 1); text_l("L", hx + 6 * SC, hy + 22 * SC, 14 * SC); text_l("R", hx + 6 * SC, hy + hh - 34 * SC, 14 * SC);
// seca
_dgv = slider19 ? 0 : cos(slider5 / 100 * $pi * 0.5); _wgv = slider19 ? 1 : sin(slider5 / 100 * $pi * 0.5);
_dgv > 0.001 ? (
  _h0 = lv2h(20 * log10(_dgv)); gfx_set(0.85, 0.87, 0.92, 0.9);
  gfx_rect(t2x(0) - 2 * SC, _mid - _h0, 4 * SC, _h0, 1); gfx_rect(t2x(0) - 2 * SC, _mid, 4 * SC, _h0, 1);
);
// ecos
_k = 1; _fbv = slider4 / 100;
loop(_nrep,
  // nivel del eco k en dB (con la caida del lazo a 1 kHz) y del ducking actual
  _lv = 20 * log10(_wgv + 0.000001) + (slider18 ? 0 : 20 * log10(_g1 + 0.000001) * _k + 20 * log10(_fbv + 0.000001) * (_k - 1)) - dk_now;
  _k > 1 && _fbv < 0.005 && !slider18 ? _lv = -200;
  _al = _k == 1 ? 1 : 0.85;
  slider6 == 1 ? (
    _tt = floor((_k + 1) / 2) * del_ms + floor(_k / 2) * delR_ms;
    _hl = lv2h(_lv); _xx = t2x(_tt); acc(_al);
    (_k % 2) ? gfx_rect(_xx - 3 * SC, _mid - _hl, 6 * SC, _hl, 1) : gfx_rect(_xx - 3 * SC, _mid, 6 * SC, _hl, 1);
  ) : (
    _hl = lv2h(_lv); acc(_al);
    _xx = t2x(_k * del_ms); gfx_rect(_xx - 3 * SC, _mid - _hl, 6 * SC, _hl, 1);
    _xx = t2x(_k * delR_ms); gfx_rect(_xx - 3 * SC, _mid, 6 * SC, _hl, 1);
  );
  _k += 1;
);
fnt(4); acc(1);
slider18 ? strcpy(#a, "FREEZE") : sprintf(#a, "FEEDBACK %d %%", floor(slider4 + 0.5));
sprintf(#s, "%s   %s   %s", style_name(slider7), rout_name(slider6), #a); text_l(#s, hx + 24 * SC, hy + 4 * SC, 14 * SC);
dk_now > 0.3 ? ( gfx_set(1.0, 0.45, 0.40, 1); sprintf(#s, "DUCKING -%.1f dB", dk_now); text_r(#s, hx, hy + 4 * SC, hgw - 10 * SC, 14 * SC); );
(hover_id == 100 || (drag_id == 100 && drag)) ? ( gfx_set(1, 1, 1, 0.20); gfx_rect(hx, hy, hgw, hh, 0); );
hit_add(hx, hy, hgw, hh, 100);

// ---- tono de los ecos
gfx_set(0.095, 0.105, 0.135, 1); gfx_rect(fx0, dy, fw, dh, 1);
fnt(4);
_f = 100; loop(3,
  _xx = f2x(_f); gfx_set(1, 1, 1, 0.05); gfx_line(_xx, dy + 18 * SC, _xx, dy + dh - 16 * SC);
  gfx_set(0.50, 0.53, 0.60, 1); text_c(_f == 100 ? "100" : _f == 1000 ? "1k" : "10k", _xx - 20 * SC, dy + dh - 15 * SC, 40 * SC, 14 * SC);
  _f *= 10;
);
_d = -12; while (_d >= -36) ( gfx_set(1, 1, 1, 0.04); gfx_line(fx0, fdb2y(_d), fx0 + fw - 1, fdb2y(_d)); _d -= 12; );
_n = floor(fw / SC); _c = 0;
loop(_n + 1,
  _xx = fx0 + _c * SC; _m1 = loop_mag(x2f(_xx));
  _y1 = fdb2y(20 * log10(_m1 + 0.000001)); _y3 = fdb2y(60 * log10(_m1 + 0.000001));
  acc(0.10); gfx_line(_xx, _y3, _xx, dy + dh - 16 * SC);
