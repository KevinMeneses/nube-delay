  _pxx = _xx; _py1 = _y1; _py3 = _y3; _c += 1;
);
// puntos de corte
_xl = slider8 > 20.5 ? f2x(slider8) : fx0 + 6 * SC; _xh = slider9 < 19990 ? f2x(slider9) : fx0 + fw - 6 * SC;
_yy = fdb2y(-3);
_hv = hover_id == 110 || (drag && drag_id == 110); acc(1); gfx_circle(_xl, _yy, (_hv ? 7 : 5) * SC, 1, 1);
_hv = hover_id == 111 || (drag && drag_id == 111); acc(1); gfx_circle(_xh, _yy, (_hv ? 7 : 5) * SC, 1, 1);
