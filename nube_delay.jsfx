button(22, _x, _y, 96 * SC, _h, "Freeze", slider18); _x -= 80 * SC;
button(21, _x, _y, 72 * SC, _h, "Tap", 0); _x -= 106 * SC;
button(20, _x, _y, 98 * SC, _h, "A tempo", slider2 > 0);

// fila principal
_ky = py + 92 * SC; _kr = 24 * SC; _kx = 56 * SC; _ks = 86 * SC;
slider2 ? strcpy(#s, note_name(slider2)) : fmt_ms(#s, slider1); knob(1, _kx, _ky, _kr, slider2 ? "Tiempo (tempo)" : "Tiempo", #s, ctl_get(1), 0, 1); _kx += _ks;
sprintf(#s, "%+.1f %%", slider3); knob(2, _kx, _ky, _kr, "Desfase R", abs(slider3) < 0.05 ? "0 %" : #s, ctl_get(2), 1, 1); _kx += _ks;
slider18 ? strcpy(#s, "Infinito") : sprintf(#s, "%d %%", floor(slider4 + 0.5)); knob(3, _kx, _ky, _kr, "Feedback", #s, ctl_get(3), 0, !slider18); _kx += _ks;
slider19 ? strcpy(#s, "100 % (envio)") : sprintf(#s, "%d %%", floor(slider5 + 0.5)); knob(4, _kx, _ky, _kr, "Mezcla", #s, slider19 ? 1 : ctl_get(4), 0, !slider19); _kx += _ks;
